# Copy this file to `.env` and fill values before running locally.
# This file contains example configuration values and must NOT be committed
# with real secrets. The `.env` file is ignored by git by default.

# MongoDB connection string. For managed MongoDB services use the provided URI.
# Example: mongodb+srv://user:password@cluster0.mongodb.net/skillgap_db
MONGO_URI=

# JWT secret used to sign authentication tokens. Use a long random value in production.
JWT_SECRET=

# Gemini (Google Generative AI) API key for LLM features. Leave empty to disable AI features.
GEMINI_API_KEY=

# Optional: override the default embedding/model name
AI_MODEL_NAME=models/gemini-embedding-001


# Admin credentials (change in production and do not share)
# Example: ADMIN_USERNAME=admin@yourdomain.com
# Leave blank here and set a secure value in your real `.env` or host env vars.
ADMIN_USERNAME=
ADMIN_PASSWORD=
