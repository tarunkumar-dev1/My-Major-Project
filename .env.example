# Gemini AI Configuration
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_gemini_api_key_here

# MongoDB Configuration (optional - defaults to localhost)
# MONGO_URI=mongodb://localhost:27017/skillgap_db

# JWT Secret (keep secure in production)
# JWT_SECRET=your_secret_key_here

# Admin Credentials
# ADMIN_USERNAME=admin@skillgap.ai
# ADMIN_PASSWORD=Admin@123!

# Frontend Origins (for CORS)
# FRONTEND_ORIGINS=http://localhost:8000,https://myapp.vercel.app
