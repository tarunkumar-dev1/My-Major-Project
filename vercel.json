{
    "version": 2,
    "builds": [{ "src": "frontend/**", "use": "@vercel/static" }],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://YOUR-RAILWAY-BACKEND.up.railway.app/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}
